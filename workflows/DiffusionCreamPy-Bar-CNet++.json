            "widgets_values": [
              "#version 300 es\nprecision highp float;\n\nuniform sampler2D u_image0;\nuniform sampler2D u_image1;\n\nuniform vec2 u_resolution;\n\nlayout(location = 0) out vec4 fragColor0;\n\nin vec2 v_texCoord;\n\n#define src_image u_image0\n#define mask_image u_image1\n\n#define gl_FragColor fragColor0\n\nconst vec2 directions[4] = vec2[4](\n    vec2(1.0, 0.0), vec2(-1.0, 0.0),\n    vec2(0.0, 1.0), vec2(0.0, -1.0)\n);\n\nvoid main() {\n    vec2 uv = gl_FragCoord.xy / u_resolution;\n    vec4 color = texture(src_image, uv);\n    float mask = texture(mask_image, uv).r;\n\n    if (mask < 0.5) {\n        gl_FragColor = color;\n        return;\n    }\n\n    vec4 edge_color = vec4(0.0);\n\n    for (int i = 0; i < 4; i++) {\n        vec2 sample_uv = uv + directions[i] / u_resolution;\n        float sample_mask = texture(mask_image, sample_uv).r;\n        \n        if (sample_mask < 0.5) {\n            edge_color = texture(src_image, sample_uv);\n            break;\n        }\n    }\n\n    if (edge_color.a > 0.0)\n        color = edge_color;\n\n    gl_FragColor = color;\n}",
              "from_input"
            ]
